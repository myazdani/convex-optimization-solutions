{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/myazdani/convex-optimization-solutions/coverage/catalog.schema.json",
  "title": "Three-category book catalog",
  "type": "object",
  "required": [
    "schema_version",
    "source",
    "scope",
    "summary",
    "categories",
    "chapters",
    "inputs",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "summary": {
      "type": "object",
      "required": [
        "numbered_exercises",
        "computational_exercises_verified",
        "other_exercises_pending",
        "worked_examples_catalogued",
        "worked_examples_reproduced"
      ],
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "categories": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "number",
          "title",
          "index_path",
          "count"
        ],
        "properties": {
          "id": {
            "enum": [
              "examples",
              "computational_exercises",
              "other_exercises"
            ]
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "index_path": {
            "type": "string",
            "minLength": 1
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10
    },
    "inputs": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 337,
      "items": {
        "type": "object",
        "required": [
          "key",
          "id",
          "kind",
          "chapter",
          "title",
          "category",
          "status",
          "source_url"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "exercise",
              "worked_example"
            ]
          },
          "chapter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 11
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "examples",
              "computational_exercises",
              "other_exercises"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "implemented",
              "verified",
              "blocked"
            ]
          },
          "source_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "source_page": {
            "type": "integer",
            "minimum": 1
          },
          "source_pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "solution_path": {
            "type": "string",
            "minLength": 1
          },
          "results_path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
